<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
       http://www.liquibase.org/xml/ns/dbchangelog
       http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="015-create-household-incomes" author="system">

        <createTable tableName="household_incomes">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="household_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="year" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="month" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="description" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>

            <column name="amount" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="household_incomes"
            baseColumnNames="household_id"
            constraintName="fk_household_incomes_household"
            referencedTableName="households"
            referencedColumnNames="id"
            onDelete="CASCADE"/>

    </changeSet>

</databaseChangeLog>
